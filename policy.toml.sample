# local-grok-bots policy file
# Declarative config: backend choice + daemon jail behavior.
# Precedence (highest wins): managed settings > this file > built-in defaults.
# Fail-closed: if this file is missing or unparseable, the daemon defaults to
# the strictest mode (daemon jail ON, CLI backends OFF) and logs loudly.

[daemon]
# Bind address for the web portal. Loopback only by default.
bind = "127.0.0.1:8787"

# systemd unit should run as a non-root system user.
# user = "local-grok-bots"

[backend]
# Which model backend the daemon uses. One of: ollama | claude | grok
# Jail behavior follows automatically from this choice:
#   ollama -> daemon workspace jail ON  (bwrap/unshare around shell tools)
#   claude -> daemon jail OFF; Claude Code's own sandbox + managed settings
#             are the isolation boundary (Seatbelt/bubblewrap, domain
#             allowlists, credential deny/mask via InfoSec-managed policy)
#   grok   -> daemon jail OFF; Grok CLI's own sandbox is the boundary
backend = "ollama"
# Optional allow-list. A backend not listed fails the turn.
# Default (empty) allows ollama, claude, and grok.
# allow = ["ollama", "claude"]

[ollama]
# Only consulted when backend = "ollama"
host = "http://127.0.0.1:11434"
model = "llama3.1"
# Optional model allow-list. A model not listed fails the turn.
# Empty (default) allows any model the local Ollama serves.
# Useful when the enterprise wants to restrict which weights can run.
# models = ["llama3.1", "qwen2.5-coder:7b", "gemma2"]
# Whole run and one model call. Defaults 10m and 3m.
# run_timeout = "10m"
# model_timeout = "3m"

[cli]
# Only consulted when backend = "claude" or "grok"
# The daemon spawns the CLI headless and resumes sessions; it never
# re-jails the CLI process. Timer ticks are injected by resuming the
# session with a [scheduled] prompt. Claude/Grok's own tools execute
# them inside their sandbox.
idle_timeout_minutes = 30
# Window in which a user-created timer keeps a live process from being
# killed. Bot-created timers do not. Default 2.
imminent_timer_minutes = 2
# Wall clock for one CLI turn (seconds or Go duration). Default 2h.
# Managed policy can cap it with max_turn_timeout. See docs/cli-isolation.md
# (Timeouts) for every run limit.
# turn_timeout = "2h"
# Permission mode is a policy setting.
# Unspecified (empty): the CLI prompts when a person can answer on a TTY.
# If it prompts and there is no controlling terminal, the turn fails instead
# of hanging: "permission prompt requires a TTY or an explicit permission_mode".
# An always-allow mode in this file is ignored. Only the managed policy can
# set one, after InfoSec has approved it for unattended timers.
# permission_mode = "default"
#
# [cli.isolation]
# Workspace .claude/, .mcp.json, CLAUDE.md, AGENTS.md, and .grok/ files are
# never obeyed. ignore tells the CLI not to load them; refuse fails the turn.
# home = "user" and env are honored only from managed policy.
# See docs/cli-isolation.md.
# overrides = "ignore"
# home = "isolated"
# claude_home = "auto"   # macOS: user's HOME (Keychain login); Linux: isolated
# claude_sandbox = "required"  # Claude Bash sandbox on, fail closed; "off" is managed-only
# trust_system_config = false  # managed only; host CLI config stays untrusted
# Managed env cannot set GROK_CONFIG, GROK_CONFIG_PATH,
# GROK_DEFAULT_SELECTED_PERMISSION, or a GROK_* name that selects
# permission, config, mode, sandbox, hooks, plugins, skills, agents, or home.
#
# [cli.lgb]
# Floor for a repeating timer a bot creates, and how many scheduled turns
# that bot may cause in an hour. On claude or grok the defaults are 5m and
# 12 when these are unset. 0 turns that check off. Ollama is unchanged
# unless these are set. Timers created from the page are not limited here.
# min_timer_interval = "5m"
# max_scheduled_per_hour = 12
#
# [cli.permission]
# mode is the same knob as permission_mode above. The table wins when both
# are set. always-allow / bypass / dontAsk, and allow_session_grants, are
# ignored in this file. Only the managed policy can enable them.
# mode = "default"
# allow = ["Read", "Bash(git status*)"]
# deny = ["Bash(rm *)"]
# ask = ["Bash(git push*)"]
# ui_prompts sends a residual ask to the page. It waits until answered
# (from any tab, or after the page is opened) or prompt_timeout denies it.
# Off (the default) passes Claude --permission-prompts none, so a
# residual ask is denied instead of waiting.
# ui_prompts = false
# prompt_timeout = "10m"
# allow_session_grants = false
# claude_transport is mcp (default), stream_control, or none.
# mcp attaches the HTTP permission tool when ui_prompts is on and the
# daemon has an HTTP base. stream_control asks on stdin with
# --permission-prompt-tool stdio and does not pass --mcp-config.
# none always passes --permission-prompts none.
# claude_transport = "mcp"
# Optional binary pins. Prefer path + SHA-256. Empty keeps PATH launch.
# A grok pin's sha256 is compared before grok --version. A mismatch does not run the binary.
# pins = [
#   { path = "/usr/local/bin/claude", sha256 = "..." },
#   { backend = "grok", path = "/usr/local/bin/grok", sha256 = "..." },
# ]

# [tools]
# Host CLIs the daemon runs for a sandboxed bot. The bot calls
# `.lgb/bin/coi <name> ...` or `lgb coi <name> ...`. The real binary runs in
# bwrap (Linux) or sandbox-exec (macOS). That jail is the only sandbox for
# this path. The daemon does not write sandbox.toml and does not pass
# --sandbox. Workspace is writable, except <workspace>/.lgb, which is hidden.
# System dirs and the CLI file are read-only. Host /run is not mounted.
# Network is unshared. The jail reaches the network only through proxy_hosts.
# credential_home is absolute and outside the workspace; it is never mounted.
# credential_files are relative paths (for example ".grok/auth.json"). The
# jail gets a placeholder, not those bytes. The host proxy reads the real
# file and sets Authorization on the way out. The first proxy_hosts entry is
# the TLS upstream (Grok chat: cli-chat-proxy.grok.com).
# proxy_path_prefixes limits which paths receive that bearer. Omitted means
# /v1, the prefix Grok uses on that host. Any other path is 403 and is not
# forwarded. Local policy can only narrow the list.
# allow_jail_credentials = true is managed-only. It copies the real files
# into the jail and logs a warning. Local policy cannot turn it on.
# credential_files plus fixed_args --always-approve, without proxy_hosts and
# without that opt-in, is denied. If the proxy cannot start, the call is
# denied and audited as coi_proxy_unavailable.
# allowed_args lists subcommands and flags. value_flags lists flags that take
# a value; every other flag is boolean. Anything else is denied, and
# config/auth/login/logout/whoami/token/env/update/--print-config/--debug/
# --always-approve/--sandbox style arguments are denied even when listed.
# fixed_args and fixed_env are prepended by the daemon (not the bot). A
# timeout, max_output, or max_calls_per_hour of 0 denies the call. If bwrap
# cannot start, the call is denied and audited as coi_sandbox_unavailable.
# Path checks are defense in depth; the sandbox is the filesystem boundary.
# Output redaction is a backstop, not the control.
# Managed policy can lock an entry (lock = true) or ban a name (cli_ban).
# cli_allow_local = false drops local-only names. Local policy can only narrow
# a managed entry: fewer args, fewer bots, lower limits, fewer value_flags,
# credential_files, proxy_hosts, and proxy_path_prefixes. It cannot change the path, credential
# home, sandbox_bin, fixed_args, or fixed_env. The daemon re-reads this on
# each call.
# cli_ban = ["curl"]
# cli_allow_local = true
# [[tools.cli]]
# name = "grok"
# path = "/home/pixnbits/.grok/bin/grok"
# credential_home = "/var/lib/local-grok-bots/coi/grok"
# credential_files = [".grok/auth.json"]
# proxy_hosts = ["cli-chat-proxy.grok.com"]
# proxy_path_prefixes = ["/v1"]
# bots = ["bot-id-or-name"]
# allowed_args = ["-p", "--cwd", "--max-turns", "--no-auto-update"]
# value_flags = ["-p", "--cwd", "--max-turns"]
# fixed_args = ["--always-approve"]
# fixed_env = ["GROK_CLAUDE_MCPS_ENABLED=false"]
# timeout = "2m"
# max_output = 65536
# max_calls_per_hour = 30
# lock = true

[timers]
# Daemon-owned scheduler. On fire, injects a [scheduled] prompt into
# the bot's active CLI session (or starts a new one if idle).
enabled = true

[security]
# Fail-closed: refuse to start if the sandbox cannot initialize when
# the daemon jail is required (backend = ollama).
# If the chosen CLI binary is missing or its own sandbox cannot start,
# the turn fails; the daemon still serves.
fail_closed = true
# Log loudly (and refuse to start) when a user-level setting conflicts
# with a managed policy.
conflict_policy = "refuse"
# Optional DLP. Off unless one of these is set. A match or non-zero
# scanner exit fails the turn before the CLI starts. Prompts are not logged.
# dlp_patterns = ["secret-pattern"]
# dlp_file = "/etc/local-grok-bots/dlp.txt"
# dlp_command = "/usr/local/bin/dlp-scanner"
# Optional audit sink for CLI start/stop events: "stderr", "syslog", or absolute path.
# Empty leaves it off.
# audit_log = ""

[managed]
# Path where server-managed or MDM-delivered policy is read from.
# Managed settings always override this file.
# managed_path = "/etc/local-grok-bots/managed.json"
