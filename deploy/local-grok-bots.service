[Unit]
Description=Local Grok Bots
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=local-grok-bots
Group=local-grok-bots
ExecStart=/usr/local/bin/local-grok-bots
WorkingDirectory=/var/lib/local-grok-bots
Environment=HOME=/var/lib/local-grok-bots
Environment=DATA_DIR=/var/lib/local-grok-bots
Environment=BIND_ADDR=127.0.0.1:8080
Environment=OLLAMA_URL=http://127.0.0.1:11434
Environment=OLLAMA_MODEL=llama3.2
# Optional confinement policy. The default matches an unset file:
# CLI network open, grok and claude allowed. A file at
# DATA_DIR/policy.yaml, or POLICY_FILE, overrides these.
# Environment=POLICY_CLI_NETWORK=open
# Environment=POLICY_CLI_BACKENDS=grok,claude
# Environment=POLICY_FORCE_LOCAL_ONLY=false
# The directory must already exist. A missing file is created mode 0600.
# Environment=POLICY_AUDIT_LOG=/var/log/local-grok-bots/audit.log
# Alternative to open: explicit-proxy needs a destination allowlist and an
# upstream URL. The password stays in the daemon and is not copied into the CLI.
# Environment=POLICY_CLI_NETWORK=explicit-proxy
# Environment=POLICY_CLI_NET_ALLOW=api.example.com
# Environment=POLICY_HTTPS_PROXY=http://proxy.example:8080
# Optional prompt check. Off unless one of these is set. The command reads
# stdin, gets PATH only, and must not print the prompt.
# Environment=POLICY_DLP_PATTERNS=(?i)\bsecret\b
# Environment=POLICY_DLP_COMMAND=/usr/local/bin/lgb-dlp-scan
# Environment=POLICY_DLP_SCAN_TOOLS=false
# Required when BIND_ADDR is not loopback.
# Environment=AUTH_TOKEN=replace-me
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/local-grok-bots
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
