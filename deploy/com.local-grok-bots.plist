<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.local-grok-bots</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/local-grok-bots</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__HOME__/Library/Application Support/local-grok-bots</string>
	<!--
		Airgap: add POLICY_FORCE_LOCAL_ONLY=true to disable CLI backends, and
		keep OLLAMA_URL on loopback with the model already pulled.
		POLICY_CLI_NETWORK=none is the setting when a CLI stays enabled and
		must not dial out. An empty POLICY_CLI_BACKENDS allows no CLI backends.
		proxy with an empty POLICY_CLI_NET_ALLOW denies every destination.
		Grok needs api.x.ai. Claude needs api.anthropic.com, claude.ai, and
		platform.claude.com. See docs/sandbox.md.
		sandbox-exec must stay allowed. An EDR that blocks sandbox-exec or
		DYLD_INSERT_LIBRARIES makes a CLI turn fail closed. Do not install
		this plist as a LaunchDaemon. The daemon refuses to run as root.
	-->
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>DATA_DIR</key>
		<string>__HOME__/Library/Application Support/local-grok-bots</string>
		<key>BIND_ADDR</key>
		<string>127.0.0.1:8080</string>
		<key>OLLAMA_URL</key>
		<string>http://127.0.0.1:11434</string>
		<key>OLLAMA_MODEL</key>
		<string>llama3.2</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/local-grok-bots.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/local-grok-bots.log</string>
</dict>
</plist>
